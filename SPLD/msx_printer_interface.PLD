GAL22V10

CLOCK A4 A5 A2 A3 A1 A7 RDn IORQn NC NC GND
D0 CLKPSTB BDIRn WRn RESETn A6 A0 BUSY PSTBn CLKDATA D1 VCC

; Data clock HIGH when I/O WRITE to 91h
    CLKDATA = RDn * /WRn * /IORQn * A7 * /A6 * /A5 * A4 * /A3 * /A2 * /A1 * A0

; D1 follows state of BUSY when I/O READ from 90h, else Hi-Z
    D1.T = BUSY
    D1.E = /RDn * WRn * /IORQn * A7 * /A6 * /A5 * A4 * /A3 * /A2 * /A1 * /A0

; BDIRn follows state of RDn when I/O READ from 90h, else Hi-Z
    BDIRn.T = RDn
    BDIRn.E = /RDn * WRn * /IORQn * A7 * /A6 * /A5 * A4 * /A3 * /A2 * /A1 * /A0

; CLKPSTB produces rising edge upon I/O WRITE to 90h
; CLKPSTB is externaly looped back to global clock (pin 1)
; PSTBn latches state of D0 on clock rising edge
    CLKPSTB = RDn * /WRn * /IORQn * A7 * /A6 * /A5 * A4 * /A3 * /A2 * /A1 * /A0
    PSTBn.R = D0

DESCRIPTION